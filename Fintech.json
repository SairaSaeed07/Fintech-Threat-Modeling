                  "id": "506e337e-8956-4a18-9526-897cf8d7bae8",
                  "title": "Payment Request Manipulation",
                  "status": "Mitigated",
                  "severity": "Critical",
                  "type": "Tampering",
                  "description": "Payment amount, recipient account, or transaction details are modified while traveling from the customer to the API Gateway or between internal services.",
                  "mitigation": "Use TLS 1.3 for all communications, digitally sign payment requests (HMAC/JWS), perform server-side validation, and verify request integrity before processing.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                },
                {
                  "id": "494cccd1-35a5-4e78-85f2-30bc35e8ee30",
                  "title": "Duplicate Payment / Replay Fraud",
                  "status": "Mitigated",
                  "severity": "Critical",
                  "type": "Tampering",
                  "description": "A malicious user intercepts or repeatedly sends the same valid payment request, causing multiple unauthorized transactions before detection.",
                  "mitigation": "Use idempotency keys, unique transaction IDs/nonces, replay protection with timestamps, duplicate transaction detection, and real-time fraud monitoring.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": ""
