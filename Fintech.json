                {
                  "id": "861e805a-de52-4180-99d7-82d7dac535e2",
                  "title": "Unauthorized Customer/API Impersonation",
                  "status": "Mitigated",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "An attacker impersonates a legitimate customer or client application and submits fraudulent payment requests to the Fintech API Gateway.",
                  "mitigation": "Enforce OAuth 2.0/OIDC with MFA where applicable, validate JWT tokens, implement mutual TLS (mTLS) for service communication, and apply API rate limiting.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "955eb0a3-db8b-4322-bf69-ce459692350a",
                  "title": "API Gateway Resource Exhaustion",
                  "status": "Mitigated",
                  "severity": "Critical",
                  "type": "Denial of service",
                  "description": "Attackers flood the Fintech API Gateway with excessive requests, preventing legitimate payment processing and causing service disruption.",
                  "mitigation": "Implement API Gateway rate limiting, WAF, DDoS protection, request throttling, autoscaling, and circuit breakers with monitoring/alerting.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                }
